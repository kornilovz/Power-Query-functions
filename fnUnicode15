(input as text, optional decode as nullable logical) as text =>
let
    IsDecode = if decode = null then false else decode,

    InputJS =
        Text.Replace(
            Text.FromBinary(Json.FromValue(input), TextEncoding.Utf8),
            "<",
            "\u003c"
        ),

    JS = "
function cp(v) {
    if (v < 6400) return 0x3400 + v;
    if (v < 27136) return 0x4e00 + v - 6400;
    return 0xac00 + v - 27136;
}

function val(c) {
    if (c >= 0x3400 && c <= 0x4cff) return c - 0x3400;
    if (c >= 0x4e00 && c <= 0x9eff) return c - 0x4e00 + 6400;
    if (c >= 0xac00 && c <= 0xc1ff) return c - 0xac00 + 27136;
    throw new Error('Invalid character');
}

function enc(h) {
    var b = 0, n = 0, o = [], i, p;

    for (i = 0; i < h.length; i += 2) {
        b = (b << 8) | parseInt(h.substr(i, 2), 16);
        n += 8;

        if (n >= 15) {
            n -= 15;
            o.push(String.fromCharCode(cp(b >>> n)));
            b &= (1 << n) - 1;
        }
    }

    p = n ? 15 - n : 0;

    if (n) {
        o.push(String.fromCharCode(cp(b << p)));
    }

    return String.fromCharCode(65 + p) + o.join('');
}

function dec(s) {
    var p = s.charCodeAt(0) - 65;
    var b = 0, n = 0, o = [], i, v, k, x;

    if (!s.length || p < 0 || p > 14 ||
        (s.length === 1 && p !== 0)) {
        throw new Error('Invalid header');
    }

    for (i = 1; i < s.length; i++) {
        v = val(s.charCodeAt(i));
        k = i === s.length - 1 ? 15 - p : 15;

        if (i === s.length - 1 && p) {
            if ((v & ((1 << p) - 1)) !== 0) {
                throw new Error('Invalid padding');
            }
            v >>>= p;
        }

        b = (b << k) | v;
        n += k;

        while (n >= 8) {
            n -= 8;
            x = ((b >>> n) & 255).toString(16);
            o.push(x.length === 1 ? '0' + x : x);
            b &= (1 << n) - 1;
        }
    }

    if (n !== 0) {
        throw new Error('Invalid length');
    }

    return o.join('');
}

try {
    document.write("
        & (if IsDecode then "dec" else "enc")
        & "(" & InputJS & "));
} catch (e) {
    document.write('ERROR:' + e.message);
}
",

    Result = fnRunJS(JS),

    Checked =
        if Text.StartsWith(Result, "ERROR:") then
            error Result
        else
            Result
in
    Checked
