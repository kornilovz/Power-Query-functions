// ============================================================
// ТЕСТ для fnFindHeader (v3 — RenameColumns + dedupNames)
// ============================================================
// Требуется наличие в среде:
//   fnNormalize   - функция нормализации строк (см. упрощённую реализацию ниже)
//   fnFindHeader  - тестируемая функция (финальная версия из чата)
// ============================================================

let
    // -----------------------------------------------------------
    // 1. ТАБЛИЦА №1 — заголовок уже в первой строке (headersOk = true)
    //    Содержит: текст, числа, даты, null, error, спецсимволы
    // -----------------------------------------------------------
    Таблица1_Источник = #table(
        {"ID", "Дата", "Клиент", "Сумма", "Комментарий"},
        {
            {1, #date(2026, 1, 1), "Иванов И.И.", 1000.50,  "ok"},
            {2, null,               "Петров & Co", 500,      "спец.симв: №, %, @, #"},
            {3, #date(2026, 1, 3), "Сидоров ""ИП""", -200.75, null},
            {4, 5/0,                "Козлов",         null,       "деление на ноль -> error"},
            {5, #date(2026, 1, 5), null,              999999,  "большое число"}
        }
    ),

    // Оборачиваем 4-ю строку в try, чтобы получить реальную ошибку в ячейке
    Таблица1 = Table.ReplaceErrorValues(Таблица1_Источник, {{"Дата", null}}),

    // -----------------------------------------------------------
    // 2. ТАБЛИЦА №2 — заголовок находится НЕ в первой строке,
    //    а в строке с индексом 2 (0-based), т.е. это 3-я строка данных.
    //    До заголовка идут "мусорные" строки (название отчёта, дата выгрузки).
    //    Заголовок содержит дубликаты после нормализации:
    //      "Дата" и "Дата, отправки" -> после normalize оба содержат "дата"
    //      но название разное -> проверяем, что RenameColumns не падает
    //    Дополнительно проверяем case: два столбца с ИМЕНАМИ, которые
    //    после нормализации становятся идентичными: "Итог " и "итог" (регистр/пробелы)
    // -----------------------------------------------------------
    Таблица2_Строки = {
        {"Отчёт по продажам за январь", null, null, null, null, null},
        {"Дата выгрузки:", "01.03.2026", null, null, null, null},
        {"ID", "Дата", "Клиент", "Сумма", "Итог ", "итог"},   // <-- строка-заголовок (index 2)
        {1, "01.01.2026", "Иванов", 1000.50, 10, 20},
        {2, null,          "Петров", "текст_вместо_числа", 5, null},
        {3, "05.01.2026",  "Сидоров №1", -50, null, 100},
        {4, "не дата",     "Козлов @ склад", 0, 1, 1}
    },

    Таблица2_Заголовки = {"Col1","Col2","Col3","Col4","Col5","Col6"},
    Таблица2 = Table.FromRows(Таблица2_Строки, Таблица2_Заголовки),

    // -----------------------------------------------------------
    // 3. Ожидаемые столбцы для поиска заголовка
    // -----------------------------------------------------------
    Ожидаемые = {"ID", "Дата", "Клиент"},

    // -----------------------------------------------------------
    // 4. ВЫЗОВ функции для Таблицы 1 (заголовок уже на месте)
    // -----------------------------------------------------------
    Результат1 = fnFindHeader(Таблица1, Ожидаемые, null, null, true),

    // -----------------------------------------------------------
    // 5. ВЫЗОВ функции для Таблицы 2 (заголовок в строке с index=2,
    //    плюс проверка дедупликации имён "Итог " / "итог" -> "итог" / "итог_1")
    // -----------------------------------------------------------
    Результат2 = fnFindHeader(Таблица2, Ожидаемые, null, 30, true),

    // -----------------------------------------------------------
    // 6. Итоговая проверка: собираем сводку по обоим результатам
    // -----------------------------------------------------------
    Проверка = [
        Таблица1_Столбцы = Table.ColumnNames(Результат1),
        Таблица2_Столбцы = Table.ColumnNames(Результат2),
        Таблица1_КолВоСтрок = Table.RowCount(Результат1),
        Таблица2_КолВоСтрок = Table.RowCount(Результат2)
    ]
in
    Проверка